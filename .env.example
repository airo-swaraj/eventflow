# EventFlow Environment Variables Template
# Copy this file to .env and fill in your actual values

# Flask Configuration
# Generate a strong secret key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-minimum-32-characters

# MySQL Database Configuration
# When using Docker Compose, use 'db' as MYSQL_HOST
# When using local MySQL, use 'localhost'
MYSQL_HOST=db
MYSQL_USER=eventflow_user
MYSQL_PASSWORD=eventflow_pass
MYSQL_DB=eventflow_db

# Email Configuration (Gmail SMTP)
# For Gmail, you need to generate an app-specific password:
# 1. Enable 2-factor authentication on your Google account
# 2. Go to myaccount.google.com/apppasswords
# 3. Select Mail and Windows Computer
# 4. Use the generated 16-character password below
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER=noreply@eventflow.com

# Optional: Debug mode (set to False in production)
DEBUG=False
